<!-- CUSTOM DROPDOWN -->
<div class="item custom-dropdown-wrapper" id="my-tools-dropdown">
    
    <!-- Trigger -->
    <div class="custom-dropdown-trigger">
        {{svg "octicon-link-external"}} 
        <span class="custom-label">Open in</span>
        {{svg "octicon-triangle-down" 14}}
    </div>

    <!-- Menu -->
    <div class="custom-dropdown-menu hidden">
        
        <!-- 1. Reader -->
        <a class="custom-menu-item" href="$READER_BASE_LINK{{.Repository.OwnerName}}/{{.Repository.Name}}" target="_blank">
         <span class="custom-icon">
           <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><g fill="none"><path d="M20.5 2.5h-14a3 3 0 0 0-3 3v13a3 3 0 0 1 3-3h14z"/><path stroke="currentColor" stroke-linecap="square" stroke-width="2" d="M20.5 21.5h-14a3 3 0 1 1 0-6h14zm0 0v-19h-14a3 3 0 0 0-3 3v12m8-11h5"/></g></svg>
            </span>
            {{ctx.Locale.Tr "wa.see_in_reader"}} 
        </a>

        <!-- CONSOLIDATED TOPICS ONLY -->
        {{range .Repository.Topics}}
            {{if eq (StringUtils.ToUpper .) "CONSOLIDATED"}}
                
                <!-- 2. Linter -->
                <a class="custom-menu-item" href="$LINTER_BASE_LINK{{$.Repository.OwnerName}}/{{$.Repository.Name}}" target="_blank">
                   <span class="custom-icon">{{svg "octicon-check-circle"}}</span>
                   {{ctx.Locale.Tr "wa.see_in_linter"}}
                </a>

                <!-- 3. Dovetail (Scaffold) -->
                <!-- 
                   We use data attributes to store the pieces. 
                   JS will grab window.location.origin and combine them.
                -->
                <a class="custom-menu-item js-dovetail-link" 
                   href="#" 
                   target="_blank"
                   data-dovetail-base="$DOVETAIL_WEB_BASE_LINK"
                   data-owner="{{$.Repository.OwnerName}}"
                   data-repo="{{$.Repository.Name}}"
                   data-branch="{{$.BranchName}}">
                   <svg class="custom-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 28 28">
                        <path fill="currentColor" d="M10 16.796a.75.75 0 0 1 .957-.721l5.543 1.589v-7.328l-5.543 1.589a.75.75 0 0 1-.957-.721V3H6.75A3.75 3.75 0 0 0 3 6.75v14.5A3.75 3.75 0 0 0 6.75 25H10zM21.25 3H11.5v7.209l5.543-1.589a.75.75 0 0 1 .957.721v9.318a.75.75 0 0 1-.957.721L11.5 17.791V25h9.75A3.75 3.75 0 0 0 25 21.25V6.75A3.75 3.75 0 0 0 21.25 3"/>
                    </svg>
                    Dovetail
                </a>

                <!-- 4. GreekRoom -->
                <!-- 
                   Structure: $GREEKROOM_BASE_LINK/Owner/Repo (Defaults to master)
                -->
                <a class="custom-menu-item" href="$GREEKROOM_BASE_LINK{{$.Repository.OwnerName}}/{{$.Repository.Name}}" target="_blank">
                   <!-- Custom GreekRoom SVG -->
                    <svg class="custom-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
                        <path fill="currentColor" d="M11.76 19c1.16 0 1.82-1 1.82-2.71c0-1.09-.08-2.41-.28-3.62L18 5h-2.72l-2.57 4.82l-.16-.49C11.83 7.19 10.82 5 8.68 5C8 5 7.45 5.18 7 5.54C6 6.39 6 8 6 8.5h.91c.06-.44.3-1.67 1.34-1.67c1.75 0 2.55 3.17 3.15 5.59c-.9 2.16-1.4 3.72-1.4 4.55c0 .98.56 2.03 1.76 2.03"/>
                    </svg>
                    GreekRoom
                </a>

            {{end}}
        {{end}}

    </div>
</div>
